# Which database backend to use: "postgres" or "sqlite".
# start.sh / start.ps1 read this too, to decide whether to start Postgres via
# docker compose or skip it and use a local SQLite file instead.
DB_ENGINE=sqlite

# --- Postgres settings (used when DB_ENGINE=postgres) ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SQLite settings (used when DB_ENGINE=sqlite) ---
# Path to the DB file, relative to backend/ (or an absolute path). The file
# (and its parent dir) is created automatically and persists between runs.
# It's gitignored - see backend/data/ in .gitignore.
SQLITE_PATH=data/app.db
